<idea-plugin>
  <id>com.cmroche.unrealhelper</id>
  <name>UnrealHelper</name>
  <vendor>com.cmroche</vendor>

  <description><![CDATA[
    UnrealHelper adds Rider toolbar workflows for Unreal Engine launch arguments, build operations, and quick launch tasks.
  ]]></description>

  <depends>com.intellij.modules.rider</depends>
  <depends>com.jetbrains.rider-cpp</depends>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="UnrealHelper" displayType="BALLOON"/>
    <projectService serviceImplementation="com.cmroche.unrealhelper.settings.UnrealHelperSettings"/>
    <projectService serviceImplementation="com.cmroche.unrealhelper.discovery.UnrealProjectDiscoveryService"/>
    <projectService serviceImplementation="com.cmroche.unrealhelper.config.TargetPlatformConfigurationService"/>
    <projectService serviceImplementation="com.cmroche.unrealhelper.launch.QuickLaunchProcessService"/>
    <projectService serviceImplementation="com.cmroche.unrealhelper.execution.UnrealWorkflowExecutionService"/>
    <postStartupActivity implementation="com.cmroche.unrealhelper.discovery.UnrealProjectStartupActivity"/>
    <projectConfigurable
        parentId="tools"
        instance="com.cmroche.unrealhelper.settings.UnrealHelperConfigurable"
        id="com.cmroche.unrealhelper.settings"
        displayName="UnrealHelper"/>
  </extensions>

  <extensions defaultExtensionNs="com.jetbrains.rider-cpp">
    <run.configurations.cpp implementation="com.cmroche.unrealhelper.run.UnrealHelperCppConfigurationParametersExtension"/>
  </extensions>

  <extensions defaultExtensionNs="cidr">
    <runConfigurationExtension implementation="com.cmroche.unrealhelper.run.UnrealHelperCidrRunConfigurationExtension"/>
  </extensions>

  <actions>
    <group id="UnrealHelper.MainToolbarGroup" text="UnrealHelper" popup="false">
      <add-to-group group-id="MainToolbarCenter" anchor="last"/>
      <action
          id="UnrealHelper.GlobalArgsToolbarAction"
          class="com.cmroche.unrealhelper.ui.GlobalArgsToolbarAction"
          text="UnrealHelper Args"
          description="Edit UnrealHelper global launch arguments"/>
      <action
          id="UnrealHelper.TargetPlatformConfigurationSelectorAction"
          class="com.cmroche.unrealhelper.ui.TargetPlatformConfigurationSelectorAction"
          text="Target &amp; Platform"
          description="Select Target &amp; Platform configuration"/>
      <action
          id="UnrealHelper.BuildAction"
          class="com.cmroche.unrealhelper.actions.UnrealBuildAction"
          text="Build"
          description="Build selected Unreal targets"
          icon="com.intellij.icons.AllIcons.Actions.Compile"/>
      <action
          id="UnrealHelper.CookAction"
          class="com.cmroche.unrealhelper.actions.UnrealCookAction"
          text="Cook"
          description="Cook selected Unreal targets"
          icon="/icons/cook.svg"/>
      <action
          id="UnrealHelper.PackageAction"
          class="com.cmroche.unrealhelper.actions.UnrealPackageAction"
          text="Package"
          description="Package selected Unreal targets"
          icon="/icons/package.svg"/>
      <action
          id="UnrealHelper.LaunchAction"
          class="com.cmroche.unrealhelper.actions.UnrealLaunchAction"
          text="Launch"
          description="Build and launch selected Unreal targets"
          icon="com.intellij.icons.AllIcons.Actions.Execute"/>
      <action
          id="UnrealHelper.StopLaunchAction"
          class="com.cmroche.unrealhelper.actions.UnrealStopLaunchAction"
          text="Stop"
          description="Stop selected UnrealHelper launches"
          icon="com.intellij.icons.AllIcons.Actions.Suspend"/>
      <action
          id="UnrealHelper.ManageTargetPlatformConfigurationsAction"
          class="com.cmroche.unrealhelper.ui.TargetPlatformConfigurationManageAction"
          text="Configure ..."
          description="Create, modify, and delete shared Target &amp; Platform configurations"
          icon="com.intellij.icons.AllIcons.General.Settings"/>
    </group>
  </actions>
</idea-plugin>
